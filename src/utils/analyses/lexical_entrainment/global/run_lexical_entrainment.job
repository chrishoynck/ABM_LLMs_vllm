#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=lexical_entrainment
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=01:00:00
#SBATCH --output=slurm_output_%A.out

# Per-seed lexical-entrainment grids on MentalBERT embeddings.
#
# Encodes each seed's unique tweets on the GPU (minutes; ~12 h on a CPU-only int
# node), caches them per-seed under plots/lexical_entrainment/cache/, then writes
# the 4 per-setting figures + the combined 4x5 grid under
# plots/lexical_entrainment/.
#
# Submit:  sbatch src/utils/analyses/lexical_entrainment/global/run_lexical_entrainment.job
# Re-runs reuse the caches and skip existing figures. Knobs (env vars, see
# run_lexical_entrainment.sh): OVERWRITE=1, REDUCTION=umap, EMBEDDING=sbert.
# One GPU is enough — sentence-transformers encodes on a single device.

module purge
cd ~/thesis/ABM_based_LLMS/
source .venv_vllm/bin/activate

# Check whether the GPU is available
srun python -uc "import torch; print('GPU available?', torch.cuda.is_available())"

srun bash src/utils/analyses/lexical_entrainment/global/run_lexical_entrainment.sh

#!/bin/bash

#SBATCH -A <allocation>
#SBATCH --partition=general
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=00:30:00
#SBATCH --job-name=empirical
#SBATCH --output=slurm_empirical_%A.out

# Empirical Twitter + PHQ-9 analyses on Big Red 200. Submit from the repo root:
#   sbatch empirical/run_empirical.job
# CPU only: ~3k tweets through MentalBERT take minutes on 16 cores, and the queue for
# a CPU node is shorter than for a GPU. The tweets are encoded ONCE (step 1 skips
# encoders whose .npz exists), so a resubmit only reruns the cheap steps 2-4.
# Data, embeddings and results all stay in DATA_DIR, outside the repo.
#   1. S-BERT + MentalBERT embedding of every tweet
#   2. demographically matched severity ladder (adjacent-band cosine)
#   3. every MentalBERT+MLP assessor (arm x seed) scored from the saved embeddings
#   4. per-band bias / MAE table over arms

set -euo pipefail
cd "${SLURM_SUBMIT_DIR}"
source .venv_vllm/bin/activate
export PYTHONUNBUFFERED=1
export PYTHONPATH=src
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
# If compute nodes have no internet, download the two encoders once on a login node
# (see empirical/README.md) and uncomment:
# export HF_HUB_OFFLINE=1

DATA_DIR=$HOME/data/social_twitter
TWEETS=${DATA_DIR}/260923_tweets_phq.csv
USERS=${DATA_DIR}/260923_users.csv
EMB=${DATA_DIR}/embeddings
OUT=${DATA_DIR}/results

python empirical/embed.py  --tweets "$TWEETS" --out-dir "$EMB" --device cpu
python empirical/ladder.py --users "$USERS" --emb "$EMB/sbert_tweets.npz" --out "$OUT/ladder_matched.csv"
python empirical/score.py  --emb "$EMB/mentalbert_tweets.npz" --out-root "$OUT/bert_eval"
python empirical/bias.py   --eval-root "$OUT/bert_eval" --out "$OUT/bias_by_band.csv"

echo "DONE -> $OUT"

#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=seed_check
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --array=0-1
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A_%a.out

# Seeding check (checks/check_seeding.py): is seeded post generation reproducible,
# and does it make agents repeat each other? One PHQ-9 band (mild, 5-9) of the SA
# design (60 personas, agent seed 42, Qwen-teacher neighbours seed 42, 10 posts),
# generated per model in two seeded modes, three runs each:
#   shared:  --seed S            one sampling seed per round, shared by all agents (the
#                                original seeded mode; engine seed 1234)
#   agent:   --seed S --per-agent-seed   seed = SeedSequence[S, agent id, round] per request
#   runs:    seed42, seed42b (same seed again: reproducibility), seed43 (independence)
# The unseeded reference is the existing SA data (<sa root>/phq9/mild/rep_{1,2,3}).
# Task 0 = Qwen3.5-27B (.venv_vllm), task 1 = Gemma-4-31B-it (.venv_vllm_g4).
# Output: data/sensitivity/seed_test/<tag>/<mode>_seed<S>[b]/posts.csv (existing skipped).
# Then, on CPU: PYTHONPATH=src .venv_vllm/bin/python checks/check_seeding.py

module purge
cd ~/thesis/ABM_based_LLMS/
export PYTHONUNBUFFERED=1
export PYTHONPATH=src

if [[ "${SLURM_ARRAY_TASK_ID}" == "0" ]]; then
    TAG=qwen; MODEL=qwen27; PY=.venv_vllm/bin/python
else
    TAG=gemma4; MODEL=gemma4-31b; PY=.venv_vllm_g4/bin/python
    export HF_HUB_CACHE=/gpfs/work5/0/prjs1820/hf_cache
    export HF_HUB_OFFLINE=1
fi
PROMPT=data/sensitivity/inputs/prompt_iter_10.txt
PERSONAS=data/sensitivity/inputs/personas_eval_1000_phq9.csv
OUT=data/sensitivity/seed_test/${TAG}

run() {  # run <name> <seed> [extra flags]
    local csv="${OUT}/$1/posts.csv"
    [[ -f "${csv}" ]] && { echo "[skip] ${csv} exists"; return; }
    mkdir -p "${OUT}/$1"
    srun "${PY}" -m utils.create_data.generate_test_data \
        --instruction-file "${PROMPT}" --persona-phq9-file "${PERSONAS}" --model "${MODEL}" \
        --num_agents 60 --check_point 10 --agent-seed 42 --neighbor-seed 42 \
        --phq9-band-range 5 9 --output-csv "${csv}" --seed "$2" "${@:3}"
}

run shared_seed42  42
run shared_seed42b 42
run shared_seed43  43
run agent_seed42   42 --per-agent-seed
run agent_seed42b  42 --per-agent-seed
run agent_seed43   43 --per-agent-seed
echo "[done] ${OUT}"

#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=grade_check
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Grading-consistency check (checks/check_grading_consistency.py): regrade the ORIGINAL
# iter_10 test posts (100 agents x 3 posts, stored score 7.41) under three vLLM seeds,
# grade 3-post truncations of the two 300-block sets, generate fresh 3-post blocks for
# the same 100 personas with Qwen and Gemma 4 (iter_10 prompt, each model's own
# decoding) and grade those, then report. Steps whose output exists are skipped, so
# the job can be resubmitted. Qwen steps: .venv_vllm + home HF cache; Gemma
# generation: .venv_vllm_g4 + project HF cache.
# Output: data/test_post/teacher_grades/

module purge
cd ~/thesis/ABM_based_LLMS/
export PYTHONUNBUFFERED=1
export PYTHONPATH=src
OUT=data/test_post/teacher_grades
QPY=.venv_vllm/bin/python
PROMPT=data/prompt_optimization_h/qwen27_baseline/iter_10/prompt.txt

grade() {  # grade <posts csv> <out csv> [extra args]
    [[ -f "$2" ]] && { echo "[skip] $2 exists"; return; }
    srun "${QPY}" -m utils.prompt_optimizer --mode grade-posts --posts-file "$1" --out-csv "$2" "${@:3}"
}

srun "${QPY}" checks/check_grading_consistency.py prepare

# 1. the original posts, three vLLM seeds (grader noise)
grade data/prompt_optimization_h/qwen27_baseline/iter_10/test_posts.csv "${OUT}/regrade_iter10_test100.csv"
grade data/prompt_optimization_h/qwen27_baseline/iter_10/test_posts.csv "${OUT}/regrade_iter10_test100_rep2.csv" --llm-seed 2
grade data/prompt_optimization_h/qwen27_baseline/iter_10/test_posts.csv "${OUT}/regrade_iter10_test100_rep3.csv" --llm-seed 3

# 2. 3-post truncations of the 300-block sets
grade "${OUT}/qwen300_first3.csv"   "${OUT}/grades_qwen300_first3.csv"
grade "${OUT}/gemma4300_first3.csv" "${OUT}/grades_gemma4300_first3.csv"

# 3. fresh 3-post blocks for the paper's 100 test personas, both generators, then grade
if [[ ! -f "${OUT}/posts100x3_qwen.csv" ]]; then
    srun "${QPY}" -m utils.create_data.generate_test_data --instruction-file "${PROMPT}" \
        --persona-phq9-file "${OUT}/personas_test100.csv" --model qwen27 \
        --num_agents 100 --first-n --check_point 3 --output-csv "${OUT}/posts100x3_qwen.csv"
fi
if [[ ! -f "${OUT}/posts100x3_gemma4.csv" ]]; then
    HF_HUB_CACHE=/gpfs/work5/0/prjs1820/hf_cache HF_HUB_OFFLINE=1 \
    srun .venv_vllm_g4/bin/python -m utils.create_data.generate_test_data --instruction-file "${PROMPT}" \
        --persona-phq9-file "${OUT}/personas_test100.csv" --model gemma4-31b \
        --num_agents 100 --first-n --check_point 3 --output-csv "${OUT}/posts100x3_gemma4.csv"
fi
grade "${OUT}/posts100x3_qwen.csv"   "${OUT}/grades_100x3_qwen.csv"
grade "${OUT}/posts100x3_gemma4.csv" "${OUT}/grades_100x3_gemma4.csv"

srun "${QPY}" checks/check_grading_consistency.py report

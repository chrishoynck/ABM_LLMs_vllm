#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=smoke_phq9_opt
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Smoke run of jobs/run_prompt_optimizer_phq9_human.job: same data, prompts and
# flags, but 1 step of 2 blocks, a 2-block val subset and a 2-block test, written
# to a throwaway root. Exercises model load, the human-corpus data path, the
# minimal start prompt, one TextGrad backward/step and the final test write.
# ~10 min, almost all of it model load. Output dir can be deleted afterwards:
#   rm -r data/test_post/optimized_phq9_human_smoke

module purge
module load 2025
module load CUDA/12.8.0
cd ~/thesis/ABM_based_LLMS/
source .venv_vllm/bin/activate
export PYTHONUNBUFFERED=1
# No srun: a second step on gpu_h100 is refused ("Invalid generic resource (gres)
# specification"); the batch step already holds the GPU (same as run_prompt_optimizer_phq9.job).

python -uc "import torch; print('GPU available?', torch.cuda.is_available())"

PYTHONPATH=src python -m utils.prompt_optimizer --mode phq9 \
    --seeds 23 --num-steps 1 --batch-size 2 --val-sample-size 2 \
    --train-posts-file data/finetune/train_posts.csv \
    --test-posts-file data/finetune/test_posts.csv --test-sample-size 2 \
    --prompts-file data/prompts_post_minimal.json \
    --out-root data/test_post/optimized_phq9_human_smoke

echo "################ smoke outputs ################"
ls -la data/test_post/optimized_phq9_human_smoke/Qwen3.5-27B_seed23/
cat data/test_post/optimized_phq9_human_smoke/Qwen3.5-27B_seed23/run_meta.txt
cat data/test_post/optimized_phq9_human_smoke/Qwen3.5-27B_seed23/training_trajectory.csv

#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=surface_cues
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=00:30:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Surface-cue check: does the Qwen-trained regressor still score the Qwen test set
# the same way once emoji and punctuation are stripped? Swap --csv for another
# generator's test set to check that one. Output: data/test_post/surface_ablation/<tag>/.

module purge
module load 2025
module load CUDA/12.8.0
cd ~/thesis/ABM_based_LLMS/
source .venv_vllm/bin/activate

PYTHONPATH=src srun python checks/check_surface_cues.py \
    --regressor data/assessors/bert/teacher/models/Qwen3.5-27B_seed34/regressor.pt \
    --csv data/finetune/qwen/test_posts_qwen.csv \
    --out-dir data/test_post/surface_ablation/qwen_seed34

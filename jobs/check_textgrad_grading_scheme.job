#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=tgloss_grade
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Grade the paper's three stored arms with TextGrad's OPTIMISATION-time scheme
# (tg.TextLoss on a tg.sum of the posts) instead of the test scheme
# (_batch_teacher_rate on the rubric alone), under the era-correct OLD rubric.
# The TextGrad prompts were SELECTED under this scheme; the paper reported them under the
# other one. See checks/check_textgrad_grading_scheme.py for the full framing.
#
# Batched: the TextLoss call is replicated token-for-token (verified against a stub engine)
# and sent as ONE vLLM call per arm, so each arm takes minutes not ~75. One srun per arm:
# the engine is never freed.
module purge
cd ~/thesis/ABM_based_LLMS/
export PYTHONUNBUFFERED=1
export PYTHONPATH=src:checks
for tag in iter10_humanopt textgrad29 iter0_minimal; do
  srun .venv_vllm/bin/python checks/check_textgrad_grading_scheme.py grade "$tag" 1 --rubric old
done
srun .venv_vllm/bin/python checks/check_textgrad_grading_scheme.py report --rubric old

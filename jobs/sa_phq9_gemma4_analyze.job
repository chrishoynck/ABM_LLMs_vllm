#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=sa_phq9_gemma4_an
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=00:45:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# S-BERT embed + analyse the Gemma-4 PHQ-9-axis SA (after jobs/sa_phq9_gemma4.job).
# Same two steps as for Qwen (sa_embed --sbert, sa_analyze --emb-name
# embeddings_sbert.npz); the stochastic axes are absent under this root and are
# skipped, leaving the PHQ-9 ladder CSVs and agent_phq9_combined.png under
# data/sensitivity/gemma4/plots_sbert/.

module purge
cd ~/thesis/ABM_based_LLMS/
source .venv_vllm/bin/activate
export HF_HUB_CACHE=/gpfs/work5/0/prjs1820/hf_cache
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

srun env PYTHONPATH=src python -m utils.sensitivity.sa_embed --sbert --root data/sensitivity/gemma4 --device cuda
srun env PYTHONPATH=src python -m utils.sensitivity.sa_analyze --root data/sensitivity/gemma4 --emb-name embeddings_sbert.npz

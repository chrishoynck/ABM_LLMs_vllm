#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=prefix_cache
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Last uncontrolled variable behind the paper's +0.697 vs today's +0.165: prefix caching.
# In May (_build_engines at cbd4216) it was hardcoded ON; grade_posts_csv passes False today.
# This regrades the same posts with the OLD rubric AND caching back ON: the closest
# reconstruction of the May grading configuration still reachable (vLLM version aside).
# Two reps so the estimate carries its own noise bar. One srun per (arm, rep) because
# grade_posts_csv never frees its engine.
module purge
cd ~/thesis/ABM_based_LLMS/
export PYTHONUNBUFFERED=1
export PYTHONPATH=src
for rep in 1 2; do
  for tag in iter10_humanopt textgrad29 iter0_minimal; do
    srun .venv_vllm/bin/python checks/check_rubric_effect.py grade "$tag" "$rep" --prefix-cache
  done
done

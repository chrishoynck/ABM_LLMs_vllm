#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=grade_panelc
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Panel (c) of the per-model figures: every generation-prompt arm graded on the SAME
# 300 held-out personas at 3 posts per block.
#
# Why 3 and not 10. The teacher's 0-10 rubric scores diversity across the block, so a
# 10-post block punishes repetition much harder than the paper's 3-post protocol did:
# Qwen scores 5.78 at 10 posts vs 6.86 on the first 3 of the SAME blocks (r 0.37),
# while Gemma barely moves (+0.13). Grading at 10 would therefore compare the arms on a
# scale the paper's numbers (iter_10 = 7.41) do not live on, and would exaggerate the
# Qwen-Gemma gap for a reason that is about block length, not prompt quality.
#
# The truncation is EXACT, not a sample: the per-round sampling seed is `seed + round`
# and the neighbour draw is SeedSequence[neighbor_seed, agent_id, round]
# (src/utils/create_data/test_phq9_llms.py), both keyed on the round index and never on
# the total round count, and an agent's history at round r is its first r posts. So the
# first 3 posts of these 10-round runs are bit-identical to a 3-round run.
#
# Already graded, not redone here (the human-optimized arms):
#   data/test_post/teacher_grades/grades_{qwen,gemma4}300_first3.csv
# The `_first3.csv` post files are written on CPU by checks/check_grading_consistency.py
# `prepare` (human-opt) or the truncation snippet in this job's sibling docs.
# The 10-post grades of the human-opt arms (`grades_{qwen,gemma4}300.csv`) are kept as
# the block-length control; the other arms are not graded at 10.
#   sbatch jobs/grade_posts_panelc.job

module purge
cd ~/thesis/ABM_based_LLMS/
export PYTHONUNBUFFERED=1
export PYTHONPATH=src
QPY=.venv_vllm/bin/python
OUT=data/test_post/teacher_grades

grade() {  # grade <posts csv> <out csv>
    [[ -f "$2" ]] && { echo "[skip] $2 exists"; return; }
    [[ -f "$1" ]] || { echo "[missing] $1" >&2; return; }
    srun "${QPY}" -m utils.prompt_optimizer --mode grade-posts --posts-file "$1" --out-csv "$2"
}

srun "${QPY}" -uc "import torch; print('GPU available?', torch.cuda.is_available())"

grade "${OUT}/qwen_minimal300_first3.csv"    "${OUT}/grades_qwen_minimal300_first3.csv"
grade "${OUT}/gemma4_minimal300_first3.csv"  "${OUT}/grades_gemma4_minimal300_first3.csv"
grade "${OUT}/qwen_textgrad300_first3.csv"   "${OUT}/grades_qwen_textgrad300_first3.csv"
grade "${OUT}/gemma4_textgrad300_first3.csv" "${OUT}/grades_gemma4_textgrad300_first3.csv"

# Rebuild the figures (CPU; missing inputs are skipped).
srun "${QPY}" -m utils.visualization multimodel

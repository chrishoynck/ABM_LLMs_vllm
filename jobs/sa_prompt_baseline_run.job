#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=Run_model
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=03:30:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

module purge
cd ~/thesis/ABM_based_LLMS/
source .venv_vllm/bin/activate
# 1. generate (GPU) — 10 missing textgrad reps (minimal's 3 reps already present)
bash scripts/sensitivity/sa_prompt_baseline_run.sh

# 2. embed all reps -> embeddings.npz (MentalBERT, same encoder as the cross-prompt run)
PYTHONPATH=src python -m utils.sensitivity.sa_embed \
    --root data/prompt_optimization_h/qwen27_baseline/prompt_sa_reps

# 3. per-prompt within/cross cosim + heatmap with the real diagonal
PYTHONPATH=src python -m utils.sensitivity.sa_analyze --prompt-reps \
    --root data/prompt_optimization_h/qwen27_baseline/prompt_sa_reps

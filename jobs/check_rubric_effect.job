#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=rubric_effect
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Regrade the paper's three stored 100x3 post sets with the PRE-2026-05-30 rubric restored
# (checks/check_rubric_effect.py). Two reps, so the old-rubric estimate carries its own noise
# bar. ONE srun per (arm, rep): grade_posts_csv builds a vLLM engine per call and does not
# free it, so batching arms inside one process OOMs on the second engine.
module purge
cd ~/thesis/ABM_based_LLMS/
export PYTHONUNBUFFERED=1
export PYTHONPATH=src
for rep in 1 2; do
  for tag in iter10_humanopt textgrad29 iter0_minimal; do
    srun .venv_vllm/bin/python checks/check_rubric_effect.py grade "$tag" "$rep"
  done
done
srun .venv_vllm/bin/python checks/check_rubric_effect.py report

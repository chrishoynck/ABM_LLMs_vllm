#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=smoke_mm
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:45:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Smoke test for the multi-model student arms: 3 blocks (30 posts) per model
# with the real prompt + test personas, then the same for Qwen in the old venv
# as a regression check (its decoding line must still say temp=0.7 top_p=0.9).
# Outputs land in data/finetune/smoke/ (delete afterwards).

module purge
cd ~/thesis/ABM_based_LLMS/
export PYTHONUNBUFFERED=1
OUT=data/finetune/smoke
mkdir -p "$OUT"
PROMPT=data/prompt_optimization_h/qwen27_baseline/iter_10/prompt.txt
PERS=data/finetune/personas_test_300.csv

srun nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv

for m in gemma4-31b kimi-linear; do
    echo "################ $m ################"
    HF_HUB_CACHE=/gpfs/work5/0/prjs1820/hf_cache HF_HUB_OFFLINE=1 PYTHONPATH=src \
    srun .venv_vllm_g4/bin/python -m utils.create_data.generate_test_data \
        --instruction-file "$PROMPT" --persona-phq9-file "$PERS" \
        --model "$m" --num_agents 3 --check_point 10 --first-n \
        --output-csv "$OUT/smoke_${m}.csv"
done

echo "################ qwen27 (regression, old venv) ################"
PYTHONPATH=src srun .venv_vllm/bin/python -m utils.create_data.generate_test_data \
    --instruction-file "$PROMPT" --persona-phq9-file "$PERS" \
    --model qwen27 --num_agents 3 --check_point 10 --first-n \
    --output-csv "$OUT/smoke_qwen27.csv"

echo "################ outputs ################"
wc -l "$OUT"/*.csv

#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=smoke_mm
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:45:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Smoke test for the multi-model student arms: 3 blocks (30 posts) per model
# with the real prompt + test personas, then the same for Qwen in the old venv.
# Cheap (~15 min) and run BEFORE the 3,300-block jobs, because every failure
# mode below is one that would otherwise waste hours of GPU time.
#
# What to check in slurm_output_<jobid>.out and data/finetune/smoke/*.csv:
#   1. the model loads at all      -- weights present in HF_HUB_CACHE, arch
#                                     supported by this vLLM, fits in the GPUs
#                                     (e.g. a 98 GB bf16 checkpoint on 2x40 GB)
#   2. "[sa] decoding for <model>" -- the per-model temp/top_p resolved from
#                                     loaders.STUDENT_DECODING; Qwen must still
#                                     print temp=0.7 top_p=0.9 (regression)
#   3. the "[FULL PROMPT]" block   -- chat template rendered with a system turn
#                                     and no stray thinking tags
#   4. 30 rows / 3 agent_ids       -- the block loop + CSV writer work
#   5. no leaked special tokens    -- no <|channel>, <turn|>, <|im_end|>,
#                                     </think> or a literal "POST:" left in the
#                                     tweet column (i.e. parsing is correct)
#   6. few NO_POST, sane length    -- the model actually follows the prompt
#
# Outputs land in data/finetune/smoke/ (delete afterwards).

module purge
cd ~/thesis/ABM_based_LLMS/
export PYTHONUNBUFFERED=1
OUT=data/finetune/smoke
mkdir -p "$OUT"
PROMPT=data/prompt_optimization_h/qwen27_baseline/iter_10/prompt.txt
PERS=data/finetune/personas_test_300.csv

srun nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv

for m in gemma4-31b; do
    echo "################ $m ################"
    HF_HUB_CACHE=/gpfs/work5/0/prjs1820/hf_cache HF_HUB_OFFLINE=1 PYTHONPATH=src \
    srun .venv_vllm_g4/bin/python -m utils.create_data.generate_test_data \
        --instruction-file "$PROMPT" --persona-phq9-file "$PERS" \
        --model "$m" --num_agents 3 --check_point 10 --first-n \
        --output-csv "$OUT/smoke_${m}.csv"
done

echo "################ qwen27 (regression, old venv) ################"
PYTHONPATH=src srun .venv_vllm/bin/python -m utils.create_data.generate_test_data \
    --instruction-file "$PROMPT" --persona-phq9-file "$PERS" \
    --model qwen27 --num_agents 3 --check_point 10 --first-n \
    --output-csv "$OUT/smoke_qwen27.csv"

echo "################ outputs ################"
wc -l "$OUT"/*.csv

#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=Run_model
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=03:00:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

module purge
cd ~/thesis/ABM_based_LLMS/
source .venv_vllm/bin/activate

# Teacher-eval of the qwen27_baseline iter_0 POST-GENERATION prompt (--mode tweets-rerun-test).
# Not a PHQ-9-assessment job — hence the rename from run_test_phq9.job (2026-08).
PYTHONPATH=src python -m utils.prompt_optimizer \
  --mode tweets-rerun-test \
  --model Qwen/Qwen3.5-27B \
  --instruction-file data/prompt_optimization_h/qwen27_baseline/iter_0/prompt.txt \
  --persona-phq9-file data/personas_eval_1000_phq9.csv \
  --num-agents 100 \
  --sample-seed 999 \
  --tweets-per-sample 3 \
  --seeds 42

#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=assess_kimi
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Qwen3.5-27B LLM assessor (minimal + TextGrad prompts, 5 prompt seeds) on the
# Kimi-Linear 300-block held-out set. Submit after the fine-tune job:
#   sbatch --dependency=afterok:<ft_kimi jobid> jobs/run_llm_assessor_kimi.job
# Uses the Qwen venv and the home HF cache (Qwen is cached there).

module purge
cd ~/thesis/ABM_based_LLMS/
source .venv_vllm/bin/activate
export PYTHONUNBUFFERED=1

srun python -uc "import torch; print('GPU available?', torch.cuda.is_available())"

srun bash scripts/assessment/run_llm_assessor_on_heldout.sh kimi

#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=ft_gemma4
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=06:00:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Gemma-4-31B-it student arm: generate 3,000 train + 300 test blocks with the
# Qwen human-optimized prompt (decoding 1.0 / 0.975 from loaders.STUDENT_DECODING),
# fine-tune the Qwen-trained MentalBERT+MLP regressors on them, evaluate.
# Generation runs in .venv_vllm_g4 (vLLM 0.19.1); MentalBERT steps in .venv_vllm.

module purge
cd ~/thesis/ABM_based_LLMS/

# Non-Qwen weights live in project space (home quota is too small); MentalBERT
# was pre-downloaded there too so the BERT steps find it under the same cache.
export HF_HUB_CACHE=/gpfs/work5/0/prjs1820/hf_cache
export HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1

srun nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
srun .venv_vllm_g4/bin/python -uc "import torch, vllm; print('GPU available?', torch.cuda.is_available(), '| vllm', vllm.__version__, '| torch', torch.__version__)"

GEN_TAG=gemma4 GEN_MODEL=gemma4-31b \
PYTHON_GEN=.venv_vllm_g4/bin/python PYTHON_BERT=.venv_vllm/bin/python \
  srun bash scripts/assessment/run_finetune.sh

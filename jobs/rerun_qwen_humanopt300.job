#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=rerun_humanopt
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:30:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Controlled human-opt vs TextGrad contrast for Qwen.
#
# The stored human-opt 300-block corpus (data/finetune/qwen/test_posts_qwen.csv) was
# generated 2026-06-01, and 120 of its 300 blocks come from an older SA_prompt run; the
# TextGrad corpus was generated 2026-09-22. Comparing them confounds the prompt with four
# months of pipeline drift, which is why the paper's +0.70 (arms generated one day apart)
# collapsed to +0.03. Gemma's arms ARE contemporaneous and its gap survived (+0.61),
# which is the control pointing at drift.
#
# This regenerates the human-opt arm TODAY with the identical config to the TextGrad arm
# (same personas in the same order, check_point 10, seed 42, neighbour seed 42, per-model
# decoding) into a SEPARATE tag, so the fine-tune corpus the regressors were trained and
# evaluated on is untouched. Then grades its 3-post truncation on the same path.
#   sbatch jobs/rerun_qwen_humanopt300.job

module purge
cd ~/thesis/ABM_based_LLMS/
export PYTHONUNBUFFERED=1
export PYTHONPATH=src
QPY=.venv_vllm/bin/python
OUT=data/test_post/teacher_grades
POSTS=data/finetune/qwen_humanopt_v2/test_posts_qwen_humanopt_v2.csv

if [[ ! -f "${POSTS}" ]]; then
    srun "${QPY}" -m utils.create_data.generate_test_data \
        --instruction-file data/prompt_optimization_h/qwen27_baseline/iter_10/prompt.txt \
        --persona-phq9-file data/finetune/personas_test_300.csv \
        --model qwen27 --num_agents 300 --check_point 10 --first-n --chunk-size 100 \
        --output-csv "${POSTS}"
fi

srun "${QPY}" -c "
import pandas as pd
d = pd.read_csv('${POSTS}')
d.groupby('agent_id', sort=False).head(3).to_csv('${OUT}/qwen_humanopt_v2_300_first3.csv', index=False)
print('[trunc] wrote ${OUT}/qwen_humanopt_v2_300_first3.csv')
"

srun "${QPY}" -m utils.prompt_optimizer --mode grade-posts \
    --posts-file "${OUT}/qwen_humanopt_v2_300_first3.csv" \
    --out-csv "${OUT}/grades_qwen_humanopt_v2_300_first3.csv"

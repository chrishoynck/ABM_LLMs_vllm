#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=2
#SBATCH --job-name=grade_posts
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --output=/gpfs/home2/choynck/thesis/ABM_based_LLMS/slurm_output_%A.out

# Qwen3.5-27B teacher grades (0-10) every block of the paired 300-block held-out
# sets (Qwen and Gemma 4, human-optimized prompt; all 10 posts per block rated as
# one set), then refreshes the multimodel figures. Qwen venv, home HF cache.
#   sbatch jobs/grade_posts_multimodel.job

module purge
cd ~/thesis/ABM_based_LLMS/
source .venv_vllm/bin/activate
export PYTHONUNBUFFERED=1
export PYTHONPATH=src
OUT=data/test_post/teacher_grades

srun python -uc "import torch; print('GPU available?', torch.cuda.is_available())"

srun python -m utils.prompt_optimizer --mode grade-posts \
    --posts-file data/finetune/test_posts.csv --out-csv "${OUT}/grades_qwen300.csv"
srun python -m utils.prompt_optimizer --mode grade-posts \
    --posts-file data/finetune/gemma4/test_posts_gemma4.csv --out-csv "${OUT}/grades_gemma4300.csv"

srun python -m utils.visualization multimodel

# srun python src/llama_activate.py sda --num_agents 200 --rounds 600 --check_point 10 --degree 6 --save --directed --seeds 78 --use_saved_network
# srun python src/llama_activate.py sda --num_agents 200 --rounds 600 --check_point 10 --degree 9 --save --directed --seeds 88 --use_saved_network
